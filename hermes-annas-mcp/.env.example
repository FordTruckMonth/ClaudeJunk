# Copy to .env and fill in. Used by install.sh to populate the Hermes
# config entry (and usable directly by the annas-mcp binary, which
# auto-loads a .env from its working directory).

# Anna's Archive donor API key. Required for downloads; searching works
# without a valid key. Get one by donating: https://annas-archive.org/donate
ANNAS_SECRET_KEY=

# Absolute path where downloaded books/articles are written.
# MUST be absolute — the binary rejects relative paths.
ANNAS_DOWNLOAD_PATH=/absolute/path/to/downloads

# Optional: pin a specific mirror (default: annas-archive.gl)
ANNAS_BASE_URL=annas-archive.gl

# Optional: set to true to auto-discover a live mirror via SLUM
# ANNAS_AUTO_BASE_URL=true
